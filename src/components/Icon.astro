  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill={name === 'github' ? 'currentColor' : 'none'}
  stroke={name === 'github' ? 'none' : 'currentColor'}
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'user' ? (
    <>
      <circle cx="12" cy="8" r="4" />
      <path d="M4 21v-2a8 8 0 0 1 16 0v2" />
