---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import MediaCard from '../../components/MediaCard.astro';
import { categories, base } from '../../content';
export function getStaticPaths() {
  return categories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}
const { category } = Astro.props;
---

<BaseLayout
  title={`${category.title} — MobileHarness`}
  description={category.description}
>
  <SiteHeader />
  <main id="main" class="container">
    <section class="category-hero">
      <a class="text-link" href={`${base}/#demos`}>
        ← All capabilities
      </a>
      <p class="eyebrow">{category.label} / Demo collection</p>
      <h1>{category.title}</h1>
      <p class="hero-subtitle">{category.subtitle}</p>
      <p class="intro">{category.description}</p>
    </section>
    <section class="media-grid" aria-label={`${category.title} examples`}>
      {category.media.map((media) => (
        <MediaCard media={media} />
      ))}
    </section>
    <aside class="evidence-note">
      <p class="eyebrow">About these examples</p>
      <p>
        Original project screenshots and recorded animations. Captured interface
        language and state are preserved. Animations are converted from existing
        GIFs, without audio; they do not establish performance, reliability or
        hardware safety. Model, native UI and physical-device acceptance are
        documented separately.
      </p>
      <a
        class="text-link"
        href="https://github.com/devilyouwei/MobileHarness/tree/main/docs/validation"
      >
        Validation documentation ↗
      </a>
    </aside>
    <section class="section">
      <p class="eyebrow">Keep exploring</p>
      <div class="related-links">
        {categories
          .filter((c) => c.slug !== category.slug)
          .map((c) => (
            <a href={`${base}/demos/${c.slug}/`}>{c.title} ↗</a>
          ))}
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
